# ===== Database =====
DATABASE_URL="file:./dev.db"

# ===== AI Provider =====
# Provider: ollama (locale). In futuro: openai, anthropic...
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ===== Image Provider =====
# Provider per le immagini. "manual" = solo upload manuale dei file.
# "magnific" = generazione text-to-image con l'API Magnific (Mystic).
IMAGE_PROVIDER=manual

# Chiave API Magnific (obbligatoria se IMAGE_PROVIDER=magnific).
# Usata SOLO server-side, mai nel frontend. www.magnific.com/user/organization/api-keys
MAGNIFIC_API_KEY=

# ===== Video Provider =====
# "ffmpeg" usa ffmpeg locale per slideshow/reel. "none" = disabilitato.
VIDEO_PROVIDER=ffmpeg

# ===== Social Providers (API ufficiali) =====
# URL pubblico HTTPS dell'app. Obbligatorio per Instagram: i media locali
# (/uploads/...) possono essere scaricati dai server Meta solo tramite una URL
# pubblica. Lascia vuoto se l'app non pubblica contenuti su Instagram.
PUBLIC_APP_URL=

# Instagram API with Instagram Login - richiede un account Business/Creator
# collegato a una Facebook Page. Il token ha prefisso IGAA… e va usato solo con
# graph.instagram.com. L'ID è l'IG User ID restituito da GET /me (non l'IGUID).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Graph API
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# (opzionale) app-id/secrets utili per i flussi di refresh del token
CLIENT_ID=
CLIENT_SECRET=