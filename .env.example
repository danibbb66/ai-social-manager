# ===== Database =====
# PostgreSQL (es. Supabase). Il provider Prisma è "postgresql".
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres"

# ===== Cloud storage (Cloudflare R2) — SOLO in produzione su Vercel =====
# Con USE_CLOUD_STORAGE=true i media (uploads e curated) vivono nel bucket R2
# invece che in public/. In locale NON va impostata: l'app continua a usare
# public/ sul disco. Le chiavi sono percorsi relativi a public/ (es.
# "curated/photos/bali/x.jpg", "uploads/videos/reel.mp4").
# USE_CLOUD_STORAGE=true

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pubblico del bucket (es. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# ===== AI Provider =====
# Provider: ollama (locale). In futuro: openai, anthropic...
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Context window del modello in token (default Ollama: 4096, troppo stretto per
# il prompt dell'agente). 16384 = circa 2,25 GiB di KV cache per qwen3:8b:
# abbassa il valore se la GPU ha poca memoria.
OLLAMA_NUM_CTX=16384
# Tetto di token generati per risposta: l'envelope dell'agente è piccolo e non
# deve consumare il contesto residuo.
OLLAMA_NUM_PREDICT=900

# Timeout di INATTIVITÀ (ms): la richiesta viene abortita se Ollama non produce
# nulla per questo tempo (tipicamente il primo token che non arriva). Non è un
# tetto sulla durata totale: una generazione lunga ma viva prosegue. Minimo
# imposto: 60000 (60s) — i modelli 8B possono impiegare decine di secondi prima
# del primo token.
OLLAMA_TIMEOUT_MS=600000
# Tetto TOTALE della richiesta (ms), rete di sicurezza contro stream infiniti.
# Sempre ≥ del timeout di inattività.
OLLAMA_TOTAL_TIMEOUT_MS=1800000

# ===== Image Provider =====
# Provider per le immagini. "manual" = solo upload manuale dei file.
# "magnific" = generazione text-to-image con l'API Magnific (Mystic).
IMAGE_PROVIDER=manual

# Chiave API Magnific (obbligatoria se IMAGE_PROVIDER=magnific).
# Usata SOLO server-side, mai nel frontend. www.magnific.com/user/organization/api-keys
MAGNIFIC_API_KEY=

# ===== Video Provider =====
# "ffmpeg" usa ffmpeg locale per slideshow/reel. "none" = disabilitato.
VIDEO_PROVIDER=ffmpeg

# Chiavi dei provider video STOCK GRATUITI (opzionali ma consigliati).
# Sono interrogati come PRIME fonti di clip video, prima di Magnific, così i
# crediti Magnific (limitati, ~10 download/giorno) vengono risparmiati.
#
# Pixabay (https://pixabay.com/api/docs/): chiave gratuita, nessun limite di
# download/giorno, emissione chiavi ANCORA APERTA. Consigliato come prima scelta.
PIXABAY_API_KEY=

# Pexels (https://www.pexels.com/api/): gratuito, video verticali. NOTA:
# Pexels ha sospeso l'emissione di nuove chiavi; se già ne hai una, usala qui.
# Attivo automaticamente se presente.
PEXELS_API_KEY=

# Magnific come fonte di clip VIDEO: DISATTIVATO di default (i crediti,
# condivisi con le FOTO del catalogo, sono limitati ~10 download/giorno e una
# volta esauriti il download risponde 402). Imposta "true" solo se vuoi
# riattivarlo per i video. Le FOTO del catalogo restano su Magnific e non sono
# influenzate da questo flag.
# VIDEO_USE_MAGNIFIC=false

# Musica di sottofondo dei video generati (opzionale).
# Percorso assoluto di un file audio oppure un URL interno "/uploads/...".
# Ordine di risoluzione: (1) questo percorso, (2) il primo asset AUDIO in
# Media Library, (3) la colonna sonora royalty-free inclusa nel progetto
# (public/audio/default-soundtrack.m4a). Nessuna musica viene scaricata da
# Internet né hardcodata con copyright.
VIDEO_MUSIC_FILE=

# Volume della musica di sottofondo (0..1). Default 0.2 = sottofondo leggero.
VIDEO_MUSIC_VOLUME=0.2

# ===== Social Providers (API ufficiali) =====
# URL pubblico HTTPS dell'app. Obbligatorio per Instagram: i media locali
# (/uploads/...) possono essere scaricati dai server Meta solo tramite una URL
# pubblica. Lascia vuoto se l'app non pubblica contenuti su Instagram.
PUBLIC_APP_URL=

# Instagram API with Instagram Login - richiede un account Business/Creator
# collegato a una Facebook Page. Il token ha prefisso IGAA… e va usato solo con
# graph.instagram.com. L'ID è l'IG User ID restituito da GET /me (non l'IGUID).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Graph API
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# (opzionale) app-id/secrets utili per i flussi di refresh del token
CLIENT_ID=
CLIENT_SECRET=

# ===== Accesso protetto =====
# Password di accesso all'app (un solo valore condiviso). Se NON impostata,
# l'app non richiede login (fall-open). In produzione su Vercel impostala per
# proteggere l'URL da accessi non autorizzati.
APP_ACCESS_PASSWORD=

# ===== Motore editoriale =====
# Chiave API per il trigger esterno POST /api/editorial/run (header x-api-key).
# Lascia vuota per disabilitare il trigger: fail closed, ogni richiesta è rifiutata.
EDITORIAL_API_KEY=

# Secret per Vercel Cron (Authorization Bearer). Deve essere impostato anche
# nelle env vars del progetto Vercel. Lascia vuoto per disabilitare il cron.
CRON_SECRET=